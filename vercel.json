{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/site", "destination": "/site/", "permanent": true },
    { "source": "/meridian", "destination": "/#/company", "permanent": false }
  ]
}
